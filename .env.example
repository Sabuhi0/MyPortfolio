# Copy to .env for local development, or set these in the Railway service variables.

# Flask session signing key. Set it in the deploy; when it is missing locally the
# app generates one into .flask_secret_key instead of returning 500 on login.
SECRET_KEY=

# Required. Admin panel credentials (/login).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required for contact form notifications. Leave empty to turn them off - the
# message is still saved, and the reason is written to the application log.
# BotFather -> token, then message the bot once so it can reply to you.
# "python scripts/telegram_check.py" verifies the token, finds the chat id and sends a test.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Set automatically by Railway when a Postgres service is linked.
# Leave empty to use SQLite.
DATABASE_URL=

# Optional. SQLite file location - point at a mounted volume to survive redeploys.
# Example: /data/app.db
SQLITE_PATH=

# Optional. Upload directory. Defaults to static/assets/uploads.
# Do NOT point this outside the static tree: admin/routes.py stores the upload
# path in the database and templates/app/index.html renders it directly as an
# <img src>, so anything outside static/ produces 404 images.
# To keep uploads across redeploys, mount the volume at /app/static/assets/uploads
# and leave this unset - the mount hides the images committed to the repo, so
# copy them into the volume once.
UPLOAD_FOLDER=
