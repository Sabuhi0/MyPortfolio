# Copy to .env for local development, or set these in the Railway service variables.

# Required. Flask session signing key - without it login returns 500.
SECRET_KEY=

# Required. Admin panel credentials (/login).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required for contact form notifications.
# BotFather -> token, and message the bot once so it can reply to you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Set automatically by Railway when a Postgres service is linked.
# Leave empty to use SQLite.
DATABASE_URL=

# Optional. SQLite file location - point at a mounted volume to survive redeploys.
# Example: /data/app.db
SQLITE_PATH=

# Optional. Upload directory - point at a mounted volume to keep images.
# Defaults to static/assets/uploads
UPLOAD_FOLDER=
